# Vul hier je eigen Codespace host in, bv. xyz-1234.app.github.dev
# Voeg voor staging/build (bijv. Sliplane) ook de hostname toe aan VITE_DEBUG_HOSTS.
VITE_DEBUG_HOSTS=localhost,<paste-your-codespace-host-here>
# Zet deze op 1 om debugpagina in build/staging toe te staan (in combinatie met host allowlist).
VITE_ENABLE_DEBUG_PAGE=0
