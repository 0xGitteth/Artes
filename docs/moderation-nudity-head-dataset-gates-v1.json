  "pilotGoldenBenchmark": {
    "minimumImagesPerClass": 10,
    "minimumTotalImages": 70,
    "sourcePoolsMustBeDisjointFromTraining": true,
    "benchmarkOnly": true,
    "trainingReady": false,
    "notes": "A 70-image benchmark is sufficient only for early directional evaluation. Production promotion requires a larger locked benchmark and explicit per-class acceptance criteria."
