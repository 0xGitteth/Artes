  "experimentalProbeGate": {
    "purpose": "Allow an offline diagnostic linear probe only; never runtime or production promotion.",
    "minimumTotalHumanLabeledImages": 140,
    "minimumImagesPerClass": 15,
    "minimumSourcePoolsTotal": 10,
    "minimumSourcePoolsPerClass": 3,
    "maxSingleSourcePoolFraction": 0.25,
    "runtimeEligible": false
