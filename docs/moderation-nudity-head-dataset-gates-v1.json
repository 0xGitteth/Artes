    "rightsAndModerationMlUseRequired": true,
    "adultAndModelRightsEvidenceRequiredForRecognizablePeople": true,
    "sourcePoolIdRequired": true,
    "sourcePoolAwareSplitRequired": true,
    "semanticClusterMustBeExplicitlyApproved": true,
    "dinoNeighborDistanceMayNotAssignLabel": true,
    "dinoNeighborDistanceMayNotAutoApproveSemanticCluster": true,
    "realPhotographyPreferred": true,
