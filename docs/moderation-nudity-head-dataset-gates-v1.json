{
  "schemaVersion": 1,
  "planVersion": "nudity_head_dataset_gates_v1",
  "purpose": "Define measurable data gates for the first supervised Artes nudity classifier head without pretending the full moderation detector is ready.",
  "scope": {
    "firstHead": "nudity",
    "embeddingBackbone": "dinov2_vitb14",
    "classes": [
      "none",
      "underwear_swimwear",
      "implied_nude",
      "bare_buttocks",
      "female_bare_breasts",
      "genitalia",
      "male_topless"
