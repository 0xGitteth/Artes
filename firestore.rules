rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isVerifiedUser() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    function onlyKeys(allowed) {
      return request.resource.data.keys().hasOnly(allowed);
    }
    function isCodexDev() {
      return request.auth != null
        && request.auth.token.devCodex == true;
    }
    function isDevAnon() {
      return isCodexDev();
    }
    function isVerifiedOrDev() {
      return isVerifiedUser() || isCodexDev();
    }
    function noClientGateFieldWrites() {
      return resource == null ? true : !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'ageVerified',
        'isAdult',
        'ageVerifiedAt',
        'ageVerificationSource',
        'didit',
        'idv'
      ]);
    }
    function noServerManagedUserFieldWrites() {
      let serverManagedKeys = [
        'ageVerified',
        'isAdult',
        'ageVerifiedAt',
        'ageVerificationSource',
        'didit',
        'idv',
        'moderator',
        'isModerator',
        'moderationRole',
        'claims'
      ];
      return resource == null
        ? !request.resource.data.keys().hasAny(serverManagedKeys)
        : !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverManagedKeys);
    }
    function noPublicUserCounterWrites() {
      return resource == null
        ? !request.resource.data.keys().hasAny(['fansCount', 'fanOfCount'])
        : !request.resource.data.diff(resource.data).affectedKeys().hasAny(['fansCount', 'fanOfCount']);
    }
    function isModerator() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/config/moderation)
        && request.auth.token.email in get(/databases/$(database)/documents/config/moderation).data.moderatorEmails;
    }
    function hasClaimEligibility(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.ageVerified == true
        || get(/databases/$(database)/documents/users/$(uid)).data.onboardingStep >= 2;
    }
    function isAllowedCorrectionType(value) {
      return value == 'safeCorrection'
        || value == 'sensitiveCorrection'
        || value == 'reviewRequiredCorrection'
        || value == 'noCorrectionForbidden';
    }
    function isCorrectionPublishAllowed(data) {
      return !('correction' in data)
        || (
          data.correction is map
          && ('type' in data.correction)
          && isAllowedCorrectionType(data.correction.type)
          && (!('requiresModeratorReview' in data.correction) || data.correction.requiresModeratorReview is bool)
          && (!('publishBlocked' in data.correction) || data.correction.publishBlocked is bool)
          && (!('userAcceptedAt' in data.correction) || data.correction.userAcceptedAt is timestamp || data.correction.userAcceptedAt == null)
          && (
            data.correction.type == 'safeCorrection'
              ? (
                (!('requiresModeratorReview' in data.correction) || data.correction.requiresModeratorReview == false)
                && (!('publishBlocked' in data.correction) || data.correction.publishBlocked == false)
                && ('userAcceptedAt' in data.correction)
                && data.correction.userAcceptedAt is timestamp
                && data.correction.userAcceptedAt != null
              )
              : false
          )
        );
    }
    function hasConsentStatusList(data) {
      return ('consentStatuses' in data.uploadConsent)
        && data.uploadConsent.consentStatuses is list
        && data.uploadConsent.consentStatuses.hasAll([
          'pending',
          'accepted',
          'rejected',
          'notRequired',
          'anonymous',
          'pressOrStreetException'
        ]);
    }
    function isAllowedMakerRole(role) {
      return role in ['photographer', 'artist', 'videographer', 'retoucher', 'art_director'];
    }
    function creditAtHasMakerRole(credits, index) {
      return index is int
        && index >= 0
        && credits.size() > index
        && credits[index] is map
        && ('role' in credits[index])
        && isAllowedMakerRole(credits[index].role);
    }
    // The client-maintained uploadConsent.hasMaker/makerRoles fields are
    // metadata only. The security proof is uploadConsent.makerCreditIndex,
    // which must point at an actual canonical credits[] entry with a maker role.
    function hasActualMakerCredit(data) {
      return ('credits' in data)
        && data.credits is list
        && data.credits.size() > 0
        && ('uploadConsent' in data)
        && data.uploadConsent is map
        && ('makerCreditIndex' in data.uploadConsent)
        && creditAtHasMakerRole(data.credits, data.uploadConsent.makerCreditIndex);
    }
    function isPostConsentPublishAllowed(data) {
      return hasActualMakerCredit(data)
        && ('uploadConsent' in data)
        && data.uploadConsent is map
        && ('version' in data.uploadConsent)
        && data.uploadConsent.version == 1
        && ('hasMaker' in data.uploadConsent)
        && data.uploadConsent.hasMaker == true
        && ('makerRoles' in data.uploadConsent)
        && data.uploadConsent.makerRoles is list
        && data.uploadConsent.makerRoles.hasAll(['photographer', 'artist', 'videographer', 'retoucher', 'art_director'])
        && hasConsentStatusList(data)
        && ('consentAudit' in data)
        && data.consentAudit is list
        && data.consentAudit.size() > 0;
    }
    function isPostModerationPublishAllowed(data) {
      return ('outcome' in data)
        && data.outcome is string
        && data.outcome == 'allowed'
        && ('shouldReview' in data)
        && data.shouldReview is bool
        && data.shouldReview == false
        && isCorrectionPublishAllowed(data)
        && isPostConsentPublishAllowed(data);
    }

    function isLegacyPostWithoutModerationProof(data) {
      return !('outcome' in data)
        && !('shouldReview' in data);
    }
    function isPreConsentModeratedPost(data) {
      return ('outcome' in data)
        && ('shouldReview' in data)
        && (!('uploadConsent' in data) || !('consentAudit' in data));
    }
    function isLegacyPostMetadataOnlyUpdate() {
      let diff = request.resource.data.diff(resource.data);
      return diff.affectedKeys().hasOnly([
        'title',
        'description',
        'updatedAt'
      ])
        && !diff.affectedKeys().hasAny([
          'authorId',
          'imageUrl',
          'storagePath',
          'uploadId',
          'contributors',
          'credits',
          'contributorIds',
          'makerTags',
          'tags',
          'outcome',
          'shouldReview',
          'correction',
          'appliedTriggers',
          'policyAppliedTriggers',
          'forbiddenReasons',
          'requiredThemes',
          'reviewStatus',
          'uploadConsent',
          'consentAudit',
          'consentException',
          'createdAt'
        ]);
    }
    function keepsPostModerationFieldsOnUpdate() {
      let diff = request.resource.data.diff(resource.data);
      let touchesModeration = diff.affectedKeys().hasAny(['outcome', 'shouldReview', 'correction']);
      let keepsExistingCorrection = !('correction' in resource.data)
        || (('correction' in request.resource.data) && request.resource.data.correction is map);

      return keepsExistingCorrection
        && (
          !touchesModeration
          || (
            ('outcome' in request.resource.data)
            && ('shouldReview' in request.resource.data)
            && request.resource.data.outcome == 'allowed'
            && request.resource.data.shouldReview == false
            && isCorrectionPublishAllowed(request.resource.data)
          )
        );
    }

    match /config/moderation {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && noServerManagedUserFieldWrites();
      // Update must keep server-managed/sensitive fields client-immutable as well.
      allow update: if isOwner(userId)
        && noClientGateFieldWrites()
        && noServerManagedUserFieldWrites();
      allow delete: if isOwner(userId);

      match /idv/{docId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update, delete: if false;
      }

      match /threadIndex/{threadId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /drafts/{draftId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update, delete: if isVerifiedUser() && request.auth.uid == userId;
      }

      match /following/{targetUid} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if isOwner(userId)
          && targetUid != userId
          && request.resource.data.targetUid == targetUid
          && request.resource.data.createdAt == request.time
          && onlyKeys(['targetUid', 'createdAt']);
        allow update: if false;
        allow delete: if isOwner(userId);
      }

      match /announcementReads/{announcementId} {
        allow read, create, update: if request.auth != null && request.auth.uid == userId;
        allow delete: if false;
      }
    }

    match /announcements/{announcementId} {
      allow read: if request.auth != null
        && resource.data.type == 'appUpdate'
        && resource.data.status == 'active'
        && resource.data.isCurrent == true;
      allow create, update, delete: if isModerator();
    }

    match /publicUsers/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid)
        && onlyKeys([
          'uid',
          'username',
          'displayName',
          'displayNameLower',
          'photoURL',
          'avatar',
          'bio',
          'roles',
          'themes',
          'headerImage',
          'headerPosition',
          'linkedAgencyName',
          'linkedCompanyName',
          'linkedAgencyId',
          'linkedCompanyId',
          'linkedAgencyLink',
          'linkedCompanyLink',
          'authProvider',
          'onboardingComplete',
          'onboardingStep',
          'fansCount',
          'fanOfCount',
          'createdAt',
          'updatedAt'
        ])
        && noPublicUserCounterWrites()
        // Rules evaluate request.resource.data as the post-update full doc state,
        // so uid is optional, but if present it must match the document id.
        && (!('uid' in request.resource.data) || request.resource.data.uid == uid)
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 20
        && request.resource.data.username.matches('^[a-z0-9]+$')
        && request.resource.data.displayName is string
        && request.resource.data.displayNameLower is string
        && request.resource.data.displayNameLower.matches('^[a-z0-9 @._-]+$')
        && (!('authProvider' in request.resource.data) || request.resource.data.authProvider is string)
        && (!('onboardingComplete' in request.resource.data) || request.resource.data.onboardingComplete is bool)
        && (!('onboardingStep' in request.resource.data)
          || (
            request.resource.data.onboardingStep is int
            && request.resource.data.onboardingStep >= 0
            && request.resource.data.onboardingStep <= 10
          ))
        && (!('roles' in request.resource.data) || request.resource.data.roles is list)
        && (!('themes' in request.resource.data) || request.resource.data.themes is list)
        && (!('bio' in request.resource.data) || request.resource.data.bio is string)
        && (!('photoURL' in request.resource.data) || request.resource.data.photoURL is string || request.resource.data.photoURL == null)
        && (!('avatar' in request.resource.data) || request.resource.data.avatar is string || request.resource.data.avatar == null)
        && (!('headerImage' in request.resource.data) || request.resource.data.headerImage is string || request.resource.data.headerImage == null)
        && (!('headerPosition' in request.resource.data) || request.resource.data.headerPosition is string)
        && (!('linkedAgencyName' in request.resource.data) || request.resource.data.linkedAgencyName is string || request.resource.data.linkedAgencyName == null)
        && (!('linkedCompanyName' in request.resource.data) || request.resource.data.linkedCompanyName is string || request.resource.data.linkedCompanyName == null)
        && (!('linkedAgencyId' in request.resource.data) || request.resource.data.linkedAgencyId is string || request.resource.data.linkedAgencyId == null)
        && (!('linkedCompanyId' in request.resource.data) || request.resource.data.linkedCompanyId is string || request.resource.data.linkedCompanyId == null)
        && (!('linkedAgencyLink' in request.resource.data) || request.resource.data.linkedAgencyLink is string || request.resource.data.linkedAgencyLink == null)
        && (!('linkedCompanyLink' in request.resource.data) || request.resource.data.linkedCompanyLink is string || request.resource.data.linkedCompanyLink == null);
      allow delete: if false;
    }

    match /threads/{threadId} {
      allow read: if request.auth != null && (
        isDevAnon()
        // eigenaar van support thread
        || resource.data.userUid == request.auth.uid
        // participants array (jouw code gebruikt "participants")
        || (resource.data.participants is list && request.auth.uid in resource.data.participants)
        // fallback als sommige docs "participantUids" gebruiken
        || (resource.data.participantUids is list && request.auth.uid in resource.data.participantUids)
        // moderators mogen alle support threads lezen
        || (isModerator() && (resource.data.type == "support" || threadId.matches("^support_")))
        // DM support
        || (resource.data.type == 'dm' && request.auth.uid in resource.data.participantUids)
      );
      allow create: if request.auth != null
        && (
          (request.resource.data.type == 'dm'
            && request.auth.uid in request.resource.data.participantUids
            && request.resource.data.participantUids.size() == 2
            && request.resource.data.dmKey is string
            && request.resource.data.dmKey.size() > 0)
          || (request.resource.data.type == 'support'
            && request.auth.uid == request.resource.data.userUid
            && request.resource.data.threadKey is string
            && request.resource.data.threadKey.matches('^(support|moderation)_.*')
            && request.resource.data.threadKey == threadId
            && request.resource.data.userMessageAllowance is int
            && request.resource.data.userMessageAllowance >= 0
            && request.resource.data.userMessageAllowance <= 1)
        );
      allow update: if request.auth != null
        && (
          (resource.data.type == 'dm'
            && request.auth.uid in resource.data.participantUids
            && request.resource.data.diff(resource.data).changedKeys().hasOnly(['updatedAt', 'lastMessageAt', 'lastMessageText', 'lastSenderUid']))
          || (resource.data.type == 'support'
            && (
              (request.auth.uid == resource.data.userUid
                && request.resource.data.diff(resource.data).changedKeys().hasOnly([
                  'updatedAt',
                  'lastMessageAt',
                  'lastMessagePreview',
                  'hasUserMessage',
                  'unreadForModerator',
                  'unreadForUser',
                  'userDisplayName',
                  'userDisplayNameLower',
                  'userPhotoURL',
                  'userUsername'
                ])
                && request.resource.data.userMessageAllowance == resource.data.userMessageAllowance
                && request.resource.data.userCanSend == resource.data.userCanSend)
              || (isModerator()
                && request.resource.data.diff(resource.data).changedKeys().hasOnly([
                  'updatedAt',
                  'lastMessageAt',
                  'lastMessagePreview',
                  'userMessageAllowance',
                  'userCanSend',
                  'unreadForModerator',
                  'unreadForUser'
                ])
                && request.resource.data.userMessageAllowance is int
                && request.resource.data.userMessageAllowance >= 0
                && request.resource.data.userMessageAllowance <= 1)
            ))
        );
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null && (
          isDevAnon()
          || get(/databases/$(database)/documents/threads/$(threadId)).data.userUid == request.auth.uid
          || (
            get(/databases/$(database)/documents/threads/$(threadId)).data.participants is list
            && request.auth.uid in get(/databases/$(database)/documents/threads/$(threadId)).data.participants
          )
          || (
            get(/databases/$(database)/documents/threads/$(threadId)).data.participantUids is list
            && request.auth.uid in get(/databases/$(database)/documents/threads/$(threadId)).data.participantUids
          )
          || (isModerator() && (get(/databases/$(database)/documents/threads/$(threadId)).data.type == "support"
              || threadId.matches("^support_")))
          || (get(/databases/$(database)/documents/threads/$(threadId)).data.type == 'dm'
              && request.auth.uid in get(/databases/$(database)/documents/threads/$(threadId)).data.participantUids)
        );
        allow create: if request.auth != null
          && (
            (get(/databases/$(database)/documents/threads/$(threadId)).data.type == 'dm'
              && request.resource.data.senderUid == request.auth.uid
              && request.resource.data.type == 'text')
            || (get(/databases/$(database)/documents/threads/$(threadId)).data.type == 'support'
              && (
                (isModerator()
                  && request.resource.data.senderUid == request.auth.uid
                  && request.resource.data.senderRole == 'moderator')
                || (request.auth.uid == get(/databases/$(database)/documents/threads/$(threadId)).data.userUid
                  && (get(/databases/$(database)/documents/threads/$(threadId)).data.userCanSend == true
                    || get(/databases/$(database)/documents/threads/$(threadId)).data.userMessageAllowance > 0)
                  && request.resource.data.senderRole == 'user'
                  && request.resource.data.senderUid == request.auth.uid)
              )
            )
          )
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }
    }

    match /reviewCases/{reviewCaseId} {
      allow read: if isDevAnon() || isModerator() || (request.auth != null && request.auth.uid == resource.data.userId);
      allow create, update, delete: if false;
    }

    match /uploads/{uploadId} {
      allow read: if isDevAnon() || isModerator() || (request.auth != null && request.auth.uid == resource.data.userId);
      allow create, update, delete: if false;
    }

    match /moderationExamples/{exampleId} {
      allow read, create, update, delete: if false;
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if isVerifiedOrDev()
        && request.resource.data.authorId == request.auth.uid
        && isPostModerationPublishAllowed(request.resource.data);
      allow update: if isVerifiedOrDev()
        && request.resource.data.authorId == resource.data.authorId
        && resource.data.authorId == request.auth.uid
        && (
          (
            isLegacyPostWithoutModerationProof(resource.data)
            && isLegacyPostMetadataOnlyUpdate()
          )
          || (
            isPreConsentModeratedPost(resource.data)
            && isLegacyPostMetadataOnlyUpdate()
          )
          || (
            !isLegacyPostWithoutModerationProof(resource.data)
            && !isPreConsentModeratedPost(resource.data)
            && keepsPostModerationFieldsOnUpdate()
            && isPostModerationPublishAllowed(request.resource.data)
          )
        );
      allow delete: if isVerifiedOrDev() && resource.data.authorId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn() && request.auth.uid == resource.data.authorId;
      }

      match /likes/{userId} {
        allow read: if true;
        allow create, delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /communities/{communityId} {
      match /topics/{topicId} {
        match /comments/{commentId} {
          allow read: if true;
          allow create: if isSignedIn()
            && request.resource.data.authorId == request.auth.uid;
          allow update: if isSignedIn()
            && request.auth.uid == resource.data.authorId
            && request.resource.data.authorId == resource.data.authorId
            && request.resource.data.diff(resource.data).changedKeys().hasOnly(['text', 'updatedAt']);
          allow delete: if isSignedIn() && request.auth.uid == resource.data.authorId;
        }
      }
    }

    match /contributors/{contributorId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isModerator()
        || (isSignedIn()
          && resource.data.claimedByUid == request.auth.uid
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['bio', 'displayName', 'socials'])
          && request.resource.data.claimedByUid == resource.data.claimedByUid
          && request.resource.data.status == resource.data.status
          && request.resource.data.mergedInto == resource.data.mergedInto);
      allow delete: if false;
    }

    match /contributorAliases/{aliasId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isModerator();
    }

    match /claimRequests/{requestId} {
      allow create: if isSignedIn()
        && request.resource.data.claimantUid == request.auth.uid
        && hasClaimEligibility(request.auth.uid);
      allow read: if isModerator()
        || (isSignedIn() && request.auth.uid == resource.data.claimantUid);
      allow update: if isModerator()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    match /claimVouches/{vouchId} {
      allow create: if isSignedIn()
        && request.resource.data.voterUid == request.auth.uid
        && request.resource.data.claimRequestId is string
        && request.auth.uid in get(/databases/$(database)/documents/claimRequests/$(request.resource.data.claimRequestId)).data.eligibleVoucherUids;
      allow read: if isModerator()
        || (isSignedIn() && request.auth.uid == resource.data.voterUid)
        || (isSignedIn()
          && request.auth.uid == get(/databases/$(database)/documents/claimRequests/$(resource.data.claimRequestId)).data.claimantUid);
      allow update, delete: if false;
    }

    match /claimInvites/{inviteId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn()
        && (isModerator() || request.auth.uid == resource.data.creatorUid);
      allow update: if isModerator();
      allow delete: if false;
    }

    match /contributorContentRequests/{requestId} {
      allow create: if isSignedIn()
        && onlyKeys(['contributorId', 'postId', 'requestType', 'reason', 'status', 'requesterUid', 'createdAt', 'updatedAt'])
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.contributorId is string
        && request.resource.data.postId is string
        && request.resource.data.requestType in ['remove', 'hide', 'correction']
        && request.resource.data.status == 'pending'
        && (!('reason' in request.resource.data) || request.resource.data.reason is string)
        && get(/databases/$(database)/documents/contributors/$(request.resource.data.contributorId)).data.claimedByUid == request.auth.uid;
      allow read: if isModerator()
        || (isSignedIn() && request.auth.uid == resource.data.requesterUid);
      allow update: if isModerator();
      allow delete: if false;
    }
  }
}
