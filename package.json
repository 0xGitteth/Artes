{
  "name": "artes",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "purge-legacy-users": "node scripts/purgeLegacyUsers.js",
    "start": "node server/index.js",
    "test:rules": "firebase emulators:exec --only firestore,storage \"node tests/firestore.postsServerPublication.rules.test.mjs && node tests/firestore.publicUsers.rules.test.mjs && node tests/firestore.codexMarkerIsolation.rules.test.mjs && node tests/storage.profileImages.rules.test.mjs && node tests/storage.uploads.rules.test.mjs\"",
    "cleanup-upload-history": "node functions/scripts/cleanupUploadFingerprintHistory.js",
    "moderation:migrate-legacy-overrides": "node functions/scripts/migrateLegacyFreshEvaluationOverrides.js --apply",
    "moderation:verify-legacy-overrides": "node functions/scripts/migrateLegacyFreshEvaluationOverrides.js --verify",
    "test": "npm run test:rules",
    "backfill-public-users": "node functions/scripts/backfillPublicUsersFromUsers.js",
    "test:backfill-public-users": "node tests/backfillPublicUsersFromUsers.test.mjs",
    "test:rules:storage": "firebase emulators:exec --only firestore,storage \"node tests/storage.profileImages.rules.test.mjs && node tests/storage.uploads.rules.test.mjs\"",
    "reconcile-public-users": "node functions/scripts/reconcilePublicUsersForOnboarding.js",
    "reconcile-codex-dev-isolation": "node functions/scripts/reconcileCodexDevIsolation.js",
    "test:reconcile-public-users": "node tests/reconcilePublicUsersForOnboarding.test.mjs",
    "test:public-user-publication": "node tests/publicUserPublication.test.mjs && node tests/publicProfileUnpublish.test.mjs && node tests/onboardingResetState.test.mjs && node tests/followCounters.test.mjs",
    "test:codex-dev-isolation": "node --test tests/codexDevIsolation.test.mjs functions/test/codexDevLogin.test.js tests/finalHolisticIsolation.test.mjs && node tests/codexDevLegacyCleanup.test.mjs",
    "test:moderation-policy": "node --test functions/test/moderationPolicyBoundaries.test.js functions/test/moderationVisualIntensityBoundaries.test.js functions/test/moderationContextualCategoryBoundaries.test.js functions/test/geminiModerationContract.test.js functions/test/moderationGoldenClassifierExpectations.test.js functions/test/moderationGoldenManifestExpectations.test.js functions/test/moderationPolicyReviewRegressions.test.js functions/test/moderationPolicyCodexRegressions.test.js functions/test/uploaderCorrection.test.js functions/test/moderatorDecision.test.js functions/test/moderationExampleBuilder.test.js functions/test/moderationExamplesLookup.test.js functions/test/userModerationActionPolicy.test.js functions/test/uploadReuseIsolation.test.js functions/test/moderationReuseRouting.test.js functions/test/correctionReviewOwnership.test.js tests/moderationV2IntegrationSource.test.mjs",
    "golden:moderation-v2:classifier": "node functions/scripts/runModerationGoldenV2Classifier.js",
    "golden:moderation-v2:expanded": "node functions/scripts/runModerationGoldenV2Expanded.js"
  },
  "dependencies": {
    "express": "^5.2.1",
    "firebase": "^12.7.0",
    "lucide-react": "^0.562.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "firebase-tools": "^15.7.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.13",
    "vite": "^7.3.1"
  }
}
