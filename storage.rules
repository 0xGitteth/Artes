rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isVerifiedUser() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function isModerator() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email != null
        && firestore.exists(/databases/(default)/documents/config/moderation)
        && request.auth.token.email in firestore.get(/databases/(default)/documents/config/moderation).data.moderatorEmails;
    }
    function isAllowedProfileImageName(fileName) {
      return fileName == 'avatar.jpg' || fileName == 'header.jpg';
    }
    function isValidProfileImageUpload(fileName) {
      return isAllowedProfileImageName(fileName)
        && request.resource != null
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size <= 350 * 1024;
    }
    function isValidUserUploadImage(fileName) {
      return request.resource != null
        && request.resource.size <= 10 * 1024 * 1024
        && (
          (request.resource.contentType == 'image/jpeg' && (fileName.matches('.*[.]jpg') || fileName.matches('.*[.]jpeg')))
          || (request.resource.contentType == 'image/png' && fileName.matches('.*[.]png'))
          || (request.resource.contentType == 'image/webp' && fileName.matches('.*[.]webp'))
        );
    }
    function isValidClaimProofUpload(fileName) {
      return request.resource != null
        && request.resource.contentType in ['image/png', 'image/jpeg', 'image/webp']
        && request.resource.size <= 10 * 1024 * 1024
        && fileName == request.auth.uid + '.png';
    }


    function isManagedProfileOwner(ownerUid, profileId) {
      return request.auth != null
        && request.auth.uid == ownerUid
        && firestore.exists(/databases/(default)/documents/profiles/$(profileId))
        && firestore.get(/databases/(default)/documents/profiles/$(profileId)).data.ownerUid == ownerUid;
    }
    function isActiveManagedProfile(profileId) {
      return firestore.exists(/databases/(default)/documents/profiles/$(profileId))
        && firestore.get(/databases/(default)/documents/profiles/$(profileId)).data.status == 'active';
    }

    match /uploads/{userId}/{fileName} {
      allow read: if isModerator() || (request.auth != null && request.auth.uid == userId);
      allow write: if isVerifiedUser()
        && request.auth.uid == userId
        && isValidUserUploadImage(fileName);
    }

    match /uploads/{userId}/{allPaths=**} {
      allow read: if isModerator() || (request.auth != null && request.auth.uid == userId);
      allow write: if false;
    }

    match /claimProofs/{requestId}/{fileName} {
      allow read: if isModerator() || (request.auth != null && fileName == request.auth.uid + '.png');
      allow write: if isVerifiedUser()
        && isValidClaimProofUpload(fileName);
    }

    match /profileImages/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if isVerifiedUser() && request.auth.uid == userId && isValidProfileImageUpload(fileName);
    }

    match /managedProfiles/{ownerUid}/{profileId}/avatar/{fileName} {
      allow read: if isActiveManagedProfile(profileId) || isManagedProfileOwner(ownerUid, profileId);
      allow write: if isVerifiedUser()
        && isManagedProfileOwner(ownerUid, profileId)
        && fileName == 'avatar.jpg'
        && isValidProfileImageUpload(fileName);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
